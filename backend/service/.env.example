DB_URL=jdbc:postgresql://127.0.0.1:5432/alpha_media
DB_USERNAME=alpha_media_app
DB_PASSWORD=replace-with-local-app-password
# Neon에서는 DATABASE_URL_UNPOOLED를 JDBC 주소로 변환한다. 로컬은 DB_URL과 같아도 된다.
DB_MIGRATION_URL=jdbc:postgresql://127.0.0.1:5432/alpha_media
DB_MIGRATION_USERNAME=alpha_media_owner
DB_MIGRATION_PASSWORD=replace-with-local-migration-password
# HTTPS 배포 환경에서는 true로 설정한다.
SESSION_COOKIE_SECURE=false

# 루트에서 npm run accounts:configure를 실행해 비밀번호와 PBKDF2 해시를 생성한다.
CUSTOMER1_PASSWORD_HASH=replace-with-generated-password-hash
CUSTOMER2_PASSWORD_HASH=replace-with-generated-password-hash
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash

# 모의 결제는 명시적으로 켠 개발·검증 환경에서만 실행한다. 두 키는 서로 다른 무작위 값으로 정한다.
MOCK_PG_ENABLED=false
MOCK_PG_API_KEY=replace-with-random-pg-api-key-at-least-32-characters
PG_WEBHOOK_SECRET=replace-with-random-webhook-secret-at-least-32-characters
# 같은 Service의 모의 PG를 HTTP로 호출한다. Service 포트를 바꾸면 함께 변경한다.
MOCK_PG_BASE_URL=http://127.0.0.1:8081/internal/mock-pg
# 배포 시에는 Gateway의 실제 HTTPS 주소를 사용한다.
PG_WEBHOOK_URL=http://127.0.0.1:8080/webhooks/pg

# 모의 공급사도 별도로 활성화한다. 인증 키와 콜백 서명 키는 서로 다른 무작위 값이다.
MOCK_SUPPLIER_ENABLED=false
SUPPLIER_API_KEY=replace-with-random-supplier-api-key-at-least-32-characters
SUPPLIER_WEBHOOK_SECRET=replace-with-random-supplier-webhook-secret-at-least-32-characters
SUPPLIER_BASE_URL=http://127.0.0.1:8081/internal/mock-supplier
SUPPLIER_WEBHOOK_URL=http://127.0.0.1:8080/webhooks/supplier
