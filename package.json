{
  "private": true,
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix frontend run start",
    "test:orders": "node --test --test-concurrency=1 tests/orders.integration.test.mjs",
    "test:payments": "node --test --test-concurrency=1 --test-name-pattern=payment tests/orders.integration.test.mjs",
    "test:issuance": "node --test --test-concurrency=1 --test-name-pattern=issuance tests/orders.integration.test.mjs",
    "test:refunds": "node --test --test-concurrency=1 --test-name-pattern=refund tests/orders.integration.test.mjs",
    "test:tracking": "node --test --test-concurrency=1 --test-name-pattern=tracking tests/orders.integration.test.mjs",
    "test:admin": "node --test --test-concurrency=1 --test-name-pattern=\"admin console\" tests/orders.integration.test.mjs",
    "test:admin-concurrency": "node --test --test-concurrency=1 --test-name-pattern=\"admin concurrency\" tests/orders.integration.test.mjs",
    "accounts:configure": "node backend/database/configure-accounts.mjs",
    "neon:configure": "node backend/database/configure-neon.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
